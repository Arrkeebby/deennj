import java.util.Scanner;

public class SmartRestaurantOrder {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Constants
        final double DRINK_PRICE = 15.50;

        // Collect information
        System.out.print("Enter customer's name: ");
        String customerName = scanner.nextLine();

        System.out.print("Enter customer's age: ");
        int customerAge = scanner.nextInt();

        System.out.print("Enter price of the meal ($): ");
        double mealCost = scanner.nextDouble();

        System.out.print("Enter number of drinks ordered: ");
        int drinksOrdered = scanner.nextInt();

        System.out.print("Is the customer a student? (true/false): ");
        boolean isStudent = scanner.nextBoolean();

        System.out.print("Enter service rating from 1 to 5: ");
        int serviceRating = scanner.nextInt();

        // Validate service rating
        if (serviceRating < 1 || serviceRating > 5) {
            System.out.println("Error: Service rating must be between 1 and 5.");
            scanner.close();
            return;
        }

        // Calculations
        double totalDrinksCost = drinksOrdered * DRINK_PRICE;
        double subtotal = mealCost + totalDrinksCost;

        // Discount rules
        double discountPercentage = 0.0;
        if (isStudent) {
            discountPercentage = 0.10;
        }
        if (customerAge >= 60) {
            if (0.05 > discountPercentage) {
                discountPercentage = 0.05;
            }
        }
        double discountAmount = subtotal * discountPercentage;
        double discountedSubtotal = subtotal - discountAmount;

        // Tip rule
        double tipAmount = 0.0;
        if (serviceRating == 4 || serviceRating == 5) {
            tipAmount = discountedSubtotal * 0.10;
        }

        // Exact final bill & whole number cast
        double exactFinalBill = discountedSubtotal + tipAmount;
        int wholeAmount = (int) exactFinalBill;

        // Display required receipt layout
        System.out.println("\n----------------------------------------");
        System.out.println("SMART RESTAURANT");
        System.out.println("Customer: " + customerName);
        System.out.printf("Meal: $%.2f\n", mealCost);
        System.out.printf("Drinks: $%.2f\n", totalDrinksCost);
        System.out.printf("Discount: $%.2f\n", discountAmount);
        System.out.printf("Tip: $%.2f\n", tipAmount);
        System.out.printf("Final bill: $%.2f\n", exactFinalBill);
        System.out.println("Whole amount: $" + wholeAmount);
        System.out.println("----------------------------------------");

        scanner.close();
    }
}
